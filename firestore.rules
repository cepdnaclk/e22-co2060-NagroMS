rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users: own profile + read others for community/network ──
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Carts: each user owns their own cart document ──
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Products: any logged-in user can read; farmers manage their own products ──
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.farmerId == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.farmerId == request.auth.uid
        && request.resource.data.farmerId == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.farmerId == request.auth.uid;
    }

    // ── Orders: user can create + read their own orders ──
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (
          resource.data.farmerId == request.auth.uid ||
          resource.data.customerId == request.auth.uid
        );

      allow create: if request.auth != null;

      allow update: if request.auth != null
        && resource.data.farmerId == request.auth.uid;

      allow delete: if false; // backend only
    }

    // ── Reviews ──
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // ── Expert profile ──
    match /experts/{expertId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == expertId;
    }

    // ── Consultations ──
    match /consultations/{consultId} {
      allow read, write: if request.auth != null;
    }

    // ── Q&A Forum ──
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /answers/{answerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    match /qaForum/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Knowledge base articles ──
    match /articles/{articleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.expertId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.expertId == request.auth.uid;
    }

    // ── Expert connected members (farmers + customers) ──
    match /expertFarmers/{linkId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.data.expertId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.expertId == request.auth.uid;
    }

    // ── Community connections ──
    match /connections/{connectionId} {
      allow read: if request.auth != null
                  && (resource.data.requesterId == request.auth.uid
                      || resource.data.targetId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && (resource.data.requesterId == request.auth.uid
                                || resource.data.targetId == request.auth.uid);
    }

    // ── Fallback: deny everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
