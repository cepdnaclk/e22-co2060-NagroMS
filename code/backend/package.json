{
  "name": "nagroms-backend",
  "version": "1.0.0",
  "description": "NagroMS Backend API - Agro Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit",
    "test:unit": "jest tests/unit --forceExit",
    "test:integration": "jest tests/integration --forceExit",
    "test:system": "jest tests/system --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "test:report": "jest --forceExit --reporters=default --reporters=jest-html-reporter"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "models/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "verbose": true,
    "reporters": [
      "default"
    ]
  },
  "jest-html-reporter": {
    "pageTitle": "NagroMS — Test Report",
    "outputPath": "tests/test-report.html",
    "includeFailureMsg": true,
    "includeConsoleLog": false,
    "theme": "defaultTheme",
    "sort": "status",
    "dateFormat": "dd/mm/yyyy HH:MM:ss"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.2.0",
    "morgan": "^1.10.1",
    "nagroms": "file:..",
    "nodemailer": "^8.0.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-html-reporter": "^4.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  }
}
